# scripts/dev.sh start sandbox-persistence 的本机专用配置。
# 复制为被忽略的 scripts/dev.env，并 chmod 600。
# 以下四个空值分别填写独立的 `openssl rand -hex 32` 输出；首次建库后保留。
CONSOLE_INITIAL_ADMIN_API_KEY=
CONSOLE_HASH_KEY=
CONSOLE_JIT_SIGNING_KEY=
CONSOLE_DASHBOARD_JIT_SIGNING_KEY=

CONSOLE_HTTP_ADDR=127.0.0.1:18089
CONSOLE_GRPC_ADDR=127.0.0.1:15051
# 相对 console/，不要与已有开发库共用。
CONSOLE_DB_PATH=../scripts/.dev/snapshot-console.db
CONSOLE_PERSISTENCE_ENABLED=true
ONLYBOXES_DEV_SNAPSHOT_STORE=true
ONLYBOXES_DEV_SNAPSHOT_PORT=19000
# 本机 S3 自动创建 bucket/AK/SK，仅 Console 接收长期凭据。
# ONLYBOXES_DEV_MINIO_IMAGE=your-local-minio-image

# 缩小验收归档上限，使单次 staging 预留可容纳于默认 64 GiB Worker 配额。
# BoxLite 原生导出需要物化磁盘；expanded 预算不能只按测试文件大小设置。
CONSOLE_SNAPSHOT_MAX_BYTES=536870912
CONSOLE_SNAPSHOT_MAX_EXPANDED_BYTES=51539607552
CONSOLE_SNAPSHOT_MULTIPART_PART_SIZE_BYTES=67108864
CONSOLE_OFFLINE_TTL_SEC=5
CONSOLE_HEARTBEAT_INTERVAL_SEC=1
WORKER_HEARTBEAT_INTERVAL_SEC=1
WORKER_TERMINAL_LEASE_MAX_SEC=1800
# 固定同一镜像以验证相同 runtime/version/platform/format 的恢复。
WORKER_TERMINAL_EXEC_BOXLITE_IMAGE=python@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
# sandbox-persistence-docker 使用同一基础镜像，两个 Worker 各有独立持久卷。
WORKER_TERMINAL_EXEC_DOCKER_IMAGE=python@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
