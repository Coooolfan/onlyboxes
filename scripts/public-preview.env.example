# scripts/dev.sh 的本地公开预览可选配置。复制为 scripts/public-preview.env 后按需修改。
# 该文件不入库；未配置的项目使用下列默认值。

PUBLIC_PREVIEW_HTTP_PORT=80
PUBLIC_PREVIEW_DOCKER_NETWORK=onlyboxes-preview-dev
PUBLIC_PREVIEW_DOCKER_SUBNET=172.30.250.0/24
PUBLIC_PREVIEW_DOCKER_GATEWAY=172.30.250.1
PUBLIC_PREVIEW_NGINX_IMAGE=nginx:1.26-alpine
PUBLIC_PREVIEW_WORKER_IMAGE=docker:29-cli

# Worker 允许的最大续租时间。2147483647 秒约为 68 年。
PUBLIC_PREVIEW_WORKER_LEASE_MAX_SEC=2147483647

# 可选：Console API Key。未提供时使用 scripts/.dev/console-creds.json 登录。
# ONLYBOXES_DEV_CONSOLE_API_KEY=
