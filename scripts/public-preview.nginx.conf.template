events {}

http {
    map $http_upgrade $onlyboxes_connection_upgrade {
        default upgrade;
        ''      close;
    }

    map $host $onlyboxes_preview_host_valid {
        default 0;
        "~^[a-z2-7]{26}\\.__PUBLIC_PREVIEW_DOMAIN_REGEX__$" 1;
    }

    server {
        listen 80;
        server_name *.__PUBLIC_PREVIEW_DOMAIN__;

        client_max_body_size 1g;
        resolver 127.0.0.11 valid=30s ipv6=off;

        if ($onlyboxes_preview_host_valid = 0) {
            return 403;
        }

        location = /_onlyboxes_proxy_resolve {
            internal;

            proxy_pass http://host.docker.internal:__CONSOLE_HTTP_PORT__/internal/v1/proxy/resolve;
            proxy_method GET;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Onlyboxes-Internal-Token "__CONSOLE_PROXY_INTERNAL_AUTH_TOKEN__";
            proxy_set_header X-Original-Host $host;
            proxy_set_header Authorization "";
            proxy_set_header Cookie "";
        }

        location / {
            auth_request /_onlyboxes_proxy_resolve;
            auth_request_set $onlyboxes_upstream $upstream_http_x_onlyboxes_upstream;
            auth_request_set $onlyboxes_upstream_host $upstream_http_x_onlyboxes_upstream_host;
            auth_request_set $onlyboxes_route_token $upstream_http_x_onlyboxes_route_token;
            auth_request_set $onlyboxes_upstream_traffic_token $upstream_http_x_onlyboxes_upstream_traffic_token;

            proxy_http_version 1.1;
            proxy_pass $onlyboxes_upstream;
            proxy_set_header Host $onlyboxes_upstream_host;
            proxy_ssl_server_name on;
            proxy_ssl_name $onlyboxes_upstream_host;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_ssl_verify_depth 3;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Request-ID $request_id;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $onlyboxes_connection_upgrade;
            proxy_set_header X-Onlyboxes-Route-Token $onlyboxes_route_token;
            proxy_set_header e2b-traffic-access-token $onlyboxes_upstream_traffic_token;
            proxy_set_header X-Onlyboxes-Upstream "";
            proxy_set_header X-Onlyboxes-Internal-Token "";
            proxy_set_header X-Original-Host "";

            proxy_request_buffering off;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 1h;
            proxy_send_timeout 1h;

            proxy_hide_header X-Onlyboxes-Route-Token;
            proxy_hide_header X-Onlyboxes-Upstream;
            proxy_hide_header X-Onlyboxes-Upstream-Host;
            proxy_hide_header X-Onlyboxes-Upstream-Traffic-Token;
            proxy_hide_header X-Onlyboxes-Internal-Token;
            proxy_hide_header X-Original-Host;
            proxy_hide_header e2b-traffic-access-token;
        }
    }
}
